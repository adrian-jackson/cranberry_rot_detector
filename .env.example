# .env.example
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# The .env file is never committed to git (it's in .gitignore).

# Your Modal inference endpoint. Must be VITE_-prefixed — Vite only inlines
# env vars with that prefix into the frontend build.
# You get this URL after running `modal deploy backend/modal_app.py`.
# It looks like: https://yourname--cranberry-inspector-predict.modal.run
VITE_API_URL=https://your-modal-url-here.modal.run

# NOTE: the API access key is NOT set here — it's entered once in the
# browser (prompted on first visit) and stored in localStorage, so it never
# ends up baked into the public Vercel build. See dev.notes for how to
# create/share the key.
